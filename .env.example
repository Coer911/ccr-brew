# Токен @Brewing_ccrbot из @BotFather. Только в env проекта Dockhost, не в git.
BOT_TOKEN=
# Случайная строка: проверка, что вебхук зовёт именно Telegram.
BOT_WEBHOOK_SECRET=
# Случайная строка ≥ 32 символов: подпись сессий. Сменили — все разлогинятся.
SESSION_SECRET=
# Postgres. Таблицы brew_* — можно делить базу с superbot.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Telegram user_id админов через запятую (свой ID — у @userinfobot).
ADMIN_TELEGRAM_IDS=255308651
# Публичный https-адрес приложения (бесплатный домен Dockhost).
# По нему бот ставит вебхук и кнопку «Открыть».
PUBLIC_URL=
# Имя бота без @ — для виджета входа в обычном браузере.
BOT_USERNAME=Brewing_ccrbot
